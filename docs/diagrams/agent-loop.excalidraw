   "updated": 1726264800000,
   "link": null,
   "locked": false,
   "text": "Every write is logged: pending, then done or failed. Calendar event ids are fixed per plan.\nSlack and Gmail sends are keyed and looked up before any retry. Retries back off.\nAfter a crash it resumes where it stopped. A second approve changes nothing.",
   "fontSize": 15,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Every write is logged: pending, then done or failed. Calendar event ids are fixed per plan.\nSlack and Gmail sends are keyed and looked up before any retry. Retries back off.\nAfter a crash it resumes where it stopped. A second approve changes nothing.",
   "autoResize": true,
   "lineHeight": 1.25
  },
