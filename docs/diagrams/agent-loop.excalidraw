   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "OpenAI gpt-4.1-mini by default.\nClaude or Groq via LLM_PROVIDER.\nMessage eval: 15/15 (14/15 before one fix).",
   "autoResize": true,
   "lineHeight": 1.25
  },
