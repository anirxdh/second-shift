# Copy to .env and fill in. Never commit .env.

# Anthropic (the only paid piece; small usage)
ANTHROPIC_API_KEY=
# Default is claude-opus-5. claude-sonnet-5 is cheaper if you want to trim cost.
SECOND_SHIFT_MODEL=claude-opus-5

# Slack (free workspace + app from slack-app-manifest.yaml)
SLACK_BOT_TOKEN=
SLACK_DISPATCH_CHANNEL=dispatch

# Google (free; OAuth desktop client from Google Cloud)
GOOGLE_OAUTH_CLIENT_FILE=secrets/google_oauth_client.json
GOOGLE_TOKEN_FILE=secrets/google_token.json
# The Gmail account you authorized. Demo customer emails go to plus-aliases of it
# (you+cust-lee@gmail.com), so no real third party is ever emailed.
DEMO_GMAIL=

# Scheduling
DEMO_TIMEZONE=America/Los_Angeles
